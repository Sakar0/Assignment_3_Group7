@{
    ViewData["Title"] = "Items by Type Analytics";
    var booksByGenre = ViewBag.BooksByGenre ?? new List<dynamic>();
    var musicByArtist = ViewBag.MusicByArtist ?? new List<dynamic>();
    var toysByAgeGroup = ViewBag.ToysByAgeGroup ?? new List<dynamic>();
}

<div class="container-fluid mt-4 mb-5">
    <a href="/Analytics/Dashboard" class="btn btn-secondary mb-3">← Back to Dashboard</a>

    <h1 class="mb-4">
        <i class="bi bi-diagram-3"></i> Items by Type & Category
    </h1>

    <!-- Books Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-book-fill text-primary"></i> Books by Genre
                    </h5>
                </div>
                <div class="card-body">
                    @if (booksByGenre.Count > 0)
                    {
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Genre</th>
                                    <th>Count</th>
                                    <th>Percentage</th>
                                    <th>Visual</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int totalBooks = 0;
                                    foreach (var item in booksByGenre) { totalBooks += item.Count; }
                                    foreach (var genre in booksByGenre)
                                    {
                                        <tr>
                                            <td><strong>@genre.Genre</strong></td>
                                            <td>@genre.Count</td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @(totalBooks >0 ? Math.Round((double)genre.Count / totalBooks * 100, 1) : 0)%
                                                </span>
                                            </td>
                                            <td>
                                                <div class="progress" style="height: 25px;">
                                                    <div class="progress-bar bg-info" role="progressbar" 
                                                         style="width: @(totalBooks > 0 ? Math.Round((double)genre.Count / totalBooks * 100, 1) : 0)%">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No books in the catalogue.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Music Section -->
    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-music-note-beamed text-success"></i> Music by Artist
                    </h5>
                </div>
                <div class="card-body">
                    @if (musicByArtist.Count > 0)
                    {
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Artist</th>
                                    <th>Count</th>
                                    <th>Percentage</th>
                                    <th>Visual</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int totalMusic = 0;
                                    foreach (var item in musicByArtist) { totalMusic += item.Count; }
                                    foreach (var artist in musicByArtist)
                                    {
                                        <tr>
                                            <td><strong>@artist.Artist</strong></td>
                                            <td>@artist.Count</td>
                                            <td>
                                                <span class="badge bg-success">
                                                    @(totalMusic > 0 ? Math.Round((double)artist.Count / totalMusic * 100, 1) : 0)%
                                                </span>
                                            </td>
                                            <td>
                                                <div class="progress" style="height: 25px;">
                                                    <div class="progress-bar bg-success" role="progressbar" 
                                                         style="width: @(totalMusic > 0 ? Math.Round((double)artist.Count / totalMusic * 100, 1) : 0)%">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No music items in the catalogue.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Toys Section -->
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-gift text-warning"></i> Toys by Age Group
                    </h5>
                </div>
                <div class="card-body">
                    @if (toysByAgeGroup.Count > 0)
                    {
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Age Group</th>
                                    <th>Count</th>
                                    <th>Percentage</th>
                                    <th>Visual</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    int totalToys = 0;
                                    foreach (var item in toysByAgeGroup) { totalToys += item.Count; }
                                    foreach (var ageGroup in toysByAgeGroup)
                                    {
                                        <tr>
                                            <td><strong>@ageGroup.AgeGroup</strong></td>
                                            <td>@ageGroup.Count</td>
                                            <td>
                                                <span class="badge bg-warning">
                                                    @(totalToys > 0 ? Math.Round((double)ageGroup.Count / totalToys * 100, 1) : 0)%
                                                </span>
                                            </td>
                                            <td>
                                                <div class="progress" style="height: 25px;">
                                                    <div class="progress-bar bg-warning" role="progressbar" 
                                                         style="width: @(totalToys > 0 ? Math.Round((double)ageGroup.Count / totalToys * 100, 1) : 0)%">
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No toys in the catalogue.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
