@{
    ViewData["Title"] = "Create Reservation";
    var borrowerId = ViewBag.BorrowerId as string;
    var borrowerName = ViewBag.BorrowerName as string;
    var borrowers = ViewBag.Borrowers as List<Assignment2.LibraryManagement.Borrower>;
    var unavailableItems = ViewBag.UnavailableItems as List<Assignment2.LibraryManagement.Item>;
}

<div class="container mt-5">
    <h1>Create New Reservation</h1>

    @if (string.IsNullOrEmpty(borrowerId))
    {
        <div class="card">
            <div class="card-body">
                <p class="text-muted">First, please select a borrower who will make the reservation.</p>

                <form method="get" action="@Url.Action("Create", "Reservation")" class="mt-3">
                    <div class="mb-3">
                        <label for="borrowerSelect" class="form-label">Select Borrower <span class="text-danger">*</span></label>
                        <select id="borrowerSelect" name="borrowerId" class="form-select" required>
                            <option value="">-- Choose a borrower --</option>
                            @if (borrowers != null)
                            {
                                @foreach (var borrower in borrowers)
                                {
                                    <option value="@borrower.BorrowerId">@borrower.Name (@borrower.BorrowerId)</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Continue</button>
                    <a href="@Url.Action("Index", "Reservation")" class="btn btn-secondary">Cancel</a>
                </form>
            </div>
        </div>
    }
    else
    {
        <form method="post" action="@Url.Action("Create", "Reservation")" class="mt-4">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <h5 class="alert-heading">Validation Errors</h5>
                    <ul class="mb-0">
                        @foreach (var modelState in ViewData.ModelState.Values)
                        {
                            @foreach (var error in modelState.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">Reservation Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <label class="form-label"><strong>Borrower</strong></label>
                                <p class="form-control-plaintext">@borrowerName (@borrowerId)</p>
                                <input type="hidden" name="borrowerId" value="@borrowerId" />
                            </div>

                            <div class="mb-3">
                                <label for="itemSelect" class="form-label">Select Item to Reserve <span class="text-danger">*</span></label>
                                <select id="itemSelect" name="itemLibraryCode" class="form-select" required>
                                    <option value="">-- Choose an unavailable item --</option>
                                    @if (unavailableItems != null && unavailableItems.Count > 0)
                                    {
                                        @foreach (var item in unavailableItems)
                                        {
                                            <option value="@item.LibraryCode">[@item.LibraryCode] @item.Name (Status: @item.Status)</option>
                                        }
                                    }
                                    else
                                    {
                                        <option disabled>No unavailable items available for reservation</option>
                                    }
                                </select>
                                <small class="form-text text-muted">
                                    Only unavailable items can be reserved. Once an item becomes available, you will be notified.
                                </small>
                            </div>

                            <div class="mb-3">
                                <label class="form-label"><strong>About Reservations</strong></label>
                                <div class="alert alert-info" role="alert">
                                    <ul class="mb-0">
                                        <li>You can only reserve items that are currently unavailable (being borrowed or damaged)</li>
                                        <li>You cannot have multiple active reservations for the same item</li>
                                        <li>Your reservation status will show as "Pending" until the item becomes available</li>
                                        <li>You can cancel your reservation at any time while it's pending</li>
                                    </ul>
                                </div>
                            </div>

                            <div class="d-grid gap-2 d-md-flex justify-content-md-start">
                                <button type="submit" class="btn btn-success btn-lg" 
                                        @if (unavailableItems == null || unavailableItems.Count == 0) { <text>disabled</text> }>
                                    <i class="bi bi-bookmark-check"></i> Create Reservation
                                </button>
                                <a href="@Url.Action("Index", "Reservation", new { borrowerId })" class="btn btn-outline-secondary btn-lg">
                                    Cancel
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header bg-light">
                            <h5 class="card-title mb-0">Unavailable Items</h5>
                        </div>
                        <div class="card-body">
                            @if (unavailableItems != null && unavailableItems.Count > 0)
                            {
                                <p class="text-muted">@unavailableItems.Count item(s) available for reservation:</p>
                                <div class="list-group">
                                    @foreach (var item in unavailableItems.Take(5))
                                    {
                                        <div class="list-group-item">
                                            <h6 class="mb-1">@item.Name</h6>
                                            <small class="text-muted">
                                                Code: @item.LibraryCode<br />
                                                Status: <span class="badge bg-warning">@item.Status</span>
                                            </small>
                                        </div>
                                    }
                                    @if (unavailableItems.Count > 5)
                                    {
                                        <small class="text-muted p-2">... and @(unavailableItems.Count - 5) more</small>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted">No unavailable items at this time.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </form>
    }

    <div class="mt-4">
        <a href="@Url.Action("Index")" class="btn btn-secondary">Back to Home</a>
    </div>
</div>
