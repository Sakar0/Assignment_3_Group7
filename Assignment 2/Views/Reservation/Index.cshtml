@model List<Assignment2.LibraryManagement.Reservation>
@{
    ViewData["Title"] = "My Reservations";
    var borrowerId = ViewBag.BorrowerId as string;
    var borrowerName = ViewBag.BorrowerName as string;
    var borrowers = ViewBag.Borrowers as List<Assignment2.LibraryManagement.Borrower>;
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = ViewBag.ErrorMessage as string;
}

<div class="container mt-5">
    <h1>My Reservations</h1>

    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (string.IsNullOrEmpty(borrowerId))
    {
        <div class="card">
            <div class="card-body">
                <p class="text-muted">Please select a borrower to view reservations.</p>

                <form method="get" action="@Url.Action("Index", "Reservation")" class="mt-3">
                    <div class="mb-3">
                        <label for="borrowerSelect" class="form-label">Select Borrower</label>
                        <select id="borrowerSelect" name="borrowerId" class="form-select" required>
                            <option value="">-- Choose a borrower --</option>
                            @if (borrowers != null)
                            {
                                @foreach (var borrower in borrowers)
                                {
                                    <option value="@borrower.BorrowerId">@borrower.Name (@borrower.BorrowerId)</option>
                                }
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">View Reservations</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-6">
                <p><strong>Borrower:</strong> @borrowerName</p>
            </div>
            <div class="col-md-6 text-end">
                <a href="@Url.Action("Create", "Reservation", new { borrowerId })" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Create New Reservation
                </a>
            </div>
        </div>

        @if (Model == null || Model.Count == 0)
        {
            <div class="alert alert-info">
                <p>No reservations found. <a href="@Url.Action("Create", "Reservation", new { borrowerId })">Create a new reservation</a></p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Reservation ID</th>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>Status</th>
                            <th>Reservation Date</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var reservation in Model)
                        {
                            var item = Assignment2.LibraryManagement.Item.AllItems
                                .FirstOrDefault(i => i.LibraryCode == reservation.ItemLibraryCode);
                            var statusBadge = reservation.Status switch
                            {
                                "Pending" => "badge bg-warning text-dark",
                                "Fulfilled" => "badge bg-success",
                                "Cancelled" => "badge bg-secondary",
                                _ => "badge bg-info"
                            };

                            <tr>
                                <td>
                                    <a href="@Url.Action("Details", "Reservation", new { reservationId = reservation.ReservationId, borrowerId })">
                                        @reservation.ReservationId
                                    </a>
                                </td>
                                <td>@reservation.ItemLibraryCode</td>
                                <td>@(item?.Name ?? "Unknown Item")</td>
                                <td>
                                    <span class="@statusBadge">@reservation.Status</span>
                                </td>
                                <td>@reservation.ReservationDate.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>
                                    <a href="@Url.Action("Details", "Reservation", new { reservationId = reservation.ReservationId, borrowerId })" 
                                       class="btn btn-sm btn-info">
                                        View
                                    </a>
                                    @if (reservation.Status == "Pending")
                                    {
                                        <form method="post" action="@Url.Action("Cancel", "Reservation")" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="reservationId" value="@reservation.ReservationId" />
                                            <input type="hidden" name="borrowerId" value="@borrowerId" />
                                            <button type="submit" class="btn btn-sm btn-danger" 
                                                    onclick="return confirm('Are you sure you want to cancel this reservation?');">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="mt-4">
            <a href="@Url.Action("Index")" class="btn btn-secondary">Back to Home</a>
            <a href="@Url.Action("Index", "Reservation")" class="btn btn-outline-primary">Select Different Borrower</a>
        </div>
    }
</div>

<style>
    .table-hover tbody tr:hover {
        background-color: #f5f5f5;
    }
</style>
