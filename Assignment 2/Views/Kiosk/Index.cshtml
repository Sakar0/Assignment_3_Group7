@{
    ViewData["Title"] = "Library Self-Service Kiosk";
}

<div class="container py-4">
    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="display-4 mb-2">
            <i class="bi bi-upc-scan me-2 text-primary"></i> Self-Service Kiosk
        </h1>
        <p class="lead text-muted">Browse the catalogue, check out and return items yourself</p>
    </div>

    <!-- Feedback banner -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Main actions -->
    <div class="row g-4 justify-content-center">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 text-center">
                <div class="card-body d-flex flex-column py-5">
                    <i class="bi bi-search display-3 text-primary mb-3"></i>
                    <h3 class="card-title">Browse Catalogue</h3>
                    <p class="card-text text-muted">Search books, music and toys, and see what is available.</p>
                    <a href="@Url.Action("Catalogue", "Kiosk")" class="btn btn-primary btn-lg mt-auto stretched-link">
                        Browse
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 text-center">
                <div class="card-body d-flex flex-column py-5">
                    <i class="bi bi-box-arrow-right display-3 text-success mb-3"></i>
                    <h3 class="card-title">Check Out</h3>
                    <p class="card-text text-muted">Borrow an available item using your borrower ID.</p>
                    <a href="@Url.Action("Catalogue", "Kiosk")" class="btn btn-success btn-lg mt-auto stretched-link">
                        Check Out
                    </a>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 text-center">
                <div class="card-body d-flex flex-column py-5">
                    <i class="bi bi-box-arrow-in-left display-3 text-warning mb-3"></i>
                    <h3 class="card-title">Return</h3>
                    <p class="card-text text-muted">Return an item you have borrowed by its library code.</p>
                    <a href="@Url.Action("Return", "Kiosk")" class="btn btn-warning btn-lg mt-auto stretched-link">
                        Return Item
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Secondary link -->
    <div class="text-center mt-4">
        <a href="@Url.Action("MyLoans", "Kiosk")" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-person-badge me-2"></i> View My Loans
        </a>
    </div>

    <!-- Help -->
    <div class="row mt-5">
        <div class="col-12 col-lg-8 offset-lg-2">
            <div class="alert alert-info mb-0" role="note">
                <h5 class="alert-heading"><i class="bi bi-info-circle me-2"></i>How it works</h5>
                <ul class="mb-0">
                    <li><strong>Browse</strong> freely - no login needed.</li>
                    <li><strong>Check out</strong> an available item with your own <strong>Borrower ID</strong>.</li>
                    <li><strong>Return</strong> an item using its <strong>library code</strong> (e.g. BOOK001).</li>
                    <li>Standard loan rules apply (14 days, then $1/day late fine).</li>
                </ul>
            </div>
        </div>
    </div>
</div>
