@model Assignment2.LibraryManagement.Item

@{
    ViewData["Title"] = $"Kiosk - Check Out {Model.Name}";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
            <!-- Feedback banner -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">
                        <i class="bi bi-box-arrow-right me-2 text-success"></i> Check Out
                    </h1>

                    <div class="alert alert-light border" role="note">
                        <h5 class="mb-1">@Model.Name</h5>
                        <p class="mb-0 text-muted small">Library code: <code>@Model.LibraryCode</code></p>
                    </div>

                    <p class="text-muted">
                        Confirm your details to borrow this item. Standard loan: <strong>14 days</strong>
                        ($1/day late fine after that).
                    </p>

                    <form method="post" action="@Url.Action("Checkout", "Kiosk")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="code" value="@Model.LibraryCode" />

                        <div class="mb-3">
                            <label for="borrowerId" class="form-label fw-bold">Your Borrower ID</label>
                            <input type="text" class="form-control form-control-lg" id="borrowerId"
                                   name="borrowerId" placeholder="e.g. BR001" autocomplete="off"
                                   required maxlength="20" autofocus>
                            <small class="text-muted d-block mt-1">
                                Enter <strong>your own</strong> Borrower ID. You cannot borrow for someone else.
                            </small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg">
                                <i class="bi bi-check-circle me-2"></i> Confirm Check Out
                            </button>
                            <a href="@Url.Action("Item", "Kiosk", new { code = Model.LibraryCode })"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
