@{
    ViewData["Title"] = "Kiosk - Return Item";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-6">
            <!-- Feedback banner -->
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">
                        <i class="bi bi-box-arrow-in-left me-2 text-warning"></i> Return an Item
                    </h1>

                    <p class="text-muted">
                        Enter the <strong>library code</strong> of the item you are returning
                        (for example, <code>BOOK001</code>). Any late fine will be shown.
                    </p>

                    <form method="post" action="@Url.Action("Return", "Kiosk")">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label for="libraryCode" class="form-label fw-bold">Library Code</label>
                            <input type="text" class="form-control form-control-lg" id="libraryCode"
                                   name="libraryCode" placeholder="e.g. BOOK001" autocomplete="off"
                                   required maxlength="20" autofocus>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-warning btn-lg">
                                <i class="bi bi-box-arrow-in-left me-2"></i> Return Item
                            </button>
                            <a href="@Url.Action("Index", "Kiosk")" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-2"></i> Kiosk Home
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
